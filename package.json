{
  "name": "create-next-passkey-starter",
  "version": "0.1.3",
  "description": "Create a Next.js app with passkey authentication preconfigured.",
  "bin": {
    "create-next-passkey-starter": "bin/create-next-passkey-starter.mjs"
  },
  "files": [
    "app",
    "bin",
    "components",
    "components.json",
    ".env.example",
    ".gitignore",
    "eslint.config.mjs",
