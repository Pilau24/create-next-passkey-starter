    "next.config.ts",
    "postcss.config.mjs",
    "prisma",
    "prisma.config.ts",
    "public",
    "README.md",
    "tsconfig.json",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "publishConfig": {
